.content {
  padding: 16rpx 32rpx calc(var(--nav-height) + var(--crisis-size) + 64rpx);
}

/* 层级分组 */
.tier-group { margin-bottom: 40rpx; }
.tier-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 8rpx;
}
.tier-indicator {
  width: 12rpx;
  height: 64rpx;
  border-radius: 8rpx;
}
.tier-text { flex: 1; }
.tier-title { font-size: 30rpx; font-weight: 700; }
.tier-desc { font-size: 22rpx; color: var(--text-hint); }
.tier-count {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-variant-numeric: tabular-nums;
}
.tier-arrow {
  color: var(--text-hint);
  font-size: 28rpx;
  transition: transform 0.2s;
}
.tier-arrow.collapsed { transform: rotate(-90deg); }

.course-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.course-card.locked { opacity: 0.6; }
.card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.card-icon { font-size: 40rpx; }
.card-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.card-title { font-size: 30rpx; font-weight: 700; }
.card-tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.card-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
  line-height: 1.6;
}
.completed-badge {
  font-size: 22rpx;
  color: var(--success);
  margin-top: 12rpx;
  font-weight: 600;
}
.progress-bar {
  height: 8rpx;
  background: var(--border);
  border-radius: 4rpx;
  margin-top: 16rpx;
  overflow: hidden;
}
.progress-fill { height: 100%; transition: width 0.3s; }

/* 课程学习视图 */
.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx 8rpx;
}
.back-btn {
  font-size: 28rpx;
  color: var(--primary);
  min-height: 0;
  padding: 8rpx 16rpx;
}
.header .h1 {
  font-size: 34rpx;
  font-weight: 700;
  flex: 1;
}

.step-dots {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--border);
  flex: 1;
  max-width: 48rpx;
}
.dot-active { background: var(--primary); transform: scale(1.15); }
.dot-done { background: var(--success); }

.step-content { margin-bottom: 24rpx; }
.step-type {
  display: inline-block;
  font-size: 20rpx;
  color: var(--primary);
  background: rgba(74,144,217,0.12);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}
.step-title { font-size: 32rpx; font-weight: 700; margin-bottom: 20rpx; }
.step-body { font-size: 26rpx; color: var(--text-secondary); line-height: 1.8; }
.line { min-height: 44rpx; }

.step-nav {
  display: flex;
  gap: 24rpx;
}
.prev-btn, .next-btn {
  flex: 1;
  border-radius: var(--radius-md);
  padding: 26rpx;
  font-size: 28rpx;
  font-weight: 600;
  min-height: 88rpx;
}
.prev-btn {
  border: 2rpx solid var(--border);
  color: var(--text-secondary);
}
.next-btn {
  background: var(--primary);
  color: #fff;
}
.prev-btn[disabled] { opacity: 0.4; }

/* ── 引导练习播放器 ── */
.guided-player { margin-top: 8rpx; }
.animation-area {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}
.breath-container { text-align: center; }
.breath-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--primary-light);
  margin: 0 auto 24rpx;
  transition: transform 4s ease-in-out;
}
.breath-circle.breath-active { animation: breathScale 8s ease-in-out infinite; }
@keyframes breathScale {
  0%, 100% { transform: scale(0.85); background: var(--primary-light); }
  50% { transform: scale(1.15); background: var(--primary); }
}
.breath-label { font-size: 26rpx; color: var(--text-secondary); }

.body-scan-container { width: 100%; }
.body-outline {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}
.body-part {
  font-size: 24rpx;
  color: var(--text-hint);
  background: var(--bg);
  border: 2rpx solid var(--border);
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  transition: all 0.3s;
}
.body-part.body-part-active {
  color: #fff;
  background: var(--primary);
  border-color: var(--primary);
  transform: scale(1.06);
}

.medit-container { text-align: center; }
.medit-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--accent-light);
  margin: 0 auto 24rpx;
}
.medit-circle.medit-pulse { animation: meditPulse 3s ease-in-out infinite; }
@keyframes meditPulse {
  0%, 100% { transform: scale(1); opacity: 0.7; }
  50% { transform: scale(1.12); opacity: 1; }
}
.medit-label { font-size: 26rpx; color: var(--text-secondary); }

.progress-track {
  height: 8rpx;
  background: var(--border);
  border-radius: 4rpx;
  overflow: hidden;
  margin: 16rpx 0;
}
.progress-fill-bar {
  height: 100%;
  background: var(--primary);
  transition: width 1s linear;
}
.segment-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.7;
  min-height: 100rpx;
  text-align: center;
  padding: 16rpx 8rpx;
}
.segment-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin: 16rpx 0;
}
.seg-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--border);
}
.seg-dot-active { background: var(--primary); transform: scale(1.3); }
.seg-dot-done { background: var(--success); }

.timer-row {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--text-hint);
  font-variant-numeric: tabular-nums;
  padding: 8rpx 4rpx;
}
.gp-controls {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.play-btn, .skip-btn, .pause-btn, .stop-btn {
  flex: 1;
  border-radius: var(--radius-md);
  padding: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  min-height: 76rpx;
}
.play-btn { background: var(--primary); color: #fff; }
.skip-btn { background: var(--bg); border: 2rpx solid var(--border); color: var(--text-secondary); }
.pause-btn { background: var(--warning); color: #fff; }
.stop-btn { background: var(--bg); border: 2rpx solid var(--danger); color: var(--danger); }
.audio-notice {
  font-size: 22rpx;
  color: var(--text-hint);
  text-align: center;
  margin-top: 24rpx;
}
