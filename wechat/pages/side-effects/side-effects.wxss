.container {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
}
.header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.back-btn {
  font-size: 28rpx;
  color: var(--primary);
  min-height: 0;
  padding: 8rpx 16rpx;
}
.title { font-size: 38rpx; font-weight: 700; flex: 1; }

.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.tab {
  flex: 1;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 18rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
  min-height: 0;
}
.tab.active-tab {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 600;
}

.hint {
  font-size: 24rpx;
  color: var(--text-hint);
  text-align: center;
  margin-bottom: 32rpx;
}
.item { margin-bottom: 32rpx; }
.item-label { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.rating-row { display: flex; gap: 16rpx; }
.rating-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-secondary);
  min-height: 72rpx;
}
.rating-btn.selected {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 700;
}
.rating-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-hint);
}
.note {
  width: 100%;
  min-height: 140rpx;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 26rpx;
  margin: 16rpx 0 24rpx;
}
.summary {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 24rpx;
}
.summary .strong { color: var(--primary); font-size: 32rpx; }

.submit-btn {
  width: 100%;
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 26rpx;
  font-size: 30rpx;
  font-weight: 600;
  min-height: 88rpx;
}

.strategy-header {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
  line-height: 1.6;
}
.strategy-group {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}
.strategy-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.strategy-level {
  font-size: 20rpx;
  background: var(--warning);
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 400;
}
.strategy-tip {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 8rpx;
}
.strategy-note {
  font-size: 22rpx;
  color: var(--text-hint);
  margin: 16rpx 0 32rpx;
  line-height: 1.6;
}

.report-header {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.report-content {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: pre-wrap;
  font-family: monospace;
  margin-bottom: 32rpx;
  line-height: 1.7;
}

.empty {
  text-align: center;
  color: var(--text-hint);
  font-size: 26rpx;
  padding: 96rpx 32rpx;
}

.history-card { padding: 28rpx 32rpx; }
.history-date { font-size: 26rpx; font-weight: 600; }
.history-score { font-size: 24rpx; color: var(--primary); margin-top: 8rpx; }
.history-note { font-size: 22rpx; color: var(--text-hint); margin-top: 8rpx; }
.card { margin-bottom: 24rpx; }
