.content {
  padding: 16rpx 32rpx calc(var(--nav-height) + var(--crisis-size) + 64rpx);
}
.panel {
  background: var(--surface);
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}
.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
}
.panel-title { font-size: 30rpx; font-weight: 700; }
.panel-arrow {
  color: var(--text-hint);
  font-size: 24rpx;
  transition: transform 0.2s;
}
.panel.open .panel-arrow { transform: rotate(180deg); }
.panel.open .panel-title { color: var(--primary); }
.panel-body { padding: 0 32rpx 32rpx; }
.hint {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 20rpx;
}
.item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.item-input {
  flex: 1;
  background: var(--bg);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  border: 2rpx solid transparent;
}
.item-input:focus { border-color: var(--primary); background: var(--surface); }
.item-delete {
  color: var(--danger);
  font-size: 28rpx;
  min-height: 0;
  padding: 8rpx;
}
.add-btn {
  width: 100%;
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-md);
  color: var(--primary);
  font-size: 26rpx;
  padding: 20rpx;
  min-height: 0;
  margin-top: 8rpx;
}
.footer {
  font-size: 22rpx;
  color: var(--text-hint);
  text-align: center;
  padding: 48rpx 32rpx;
  line-height: 1.8;
}
