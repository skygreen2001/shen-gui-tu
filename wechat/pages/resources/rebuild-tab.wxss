.rb-container {
  padding: 0 0 32rpx;
}
.back-btn {
  font-size: 28rpx;
  color: var(--primary);
  min-height: 0;
  padding: 8rpx 0;
  margin-bottom: 16rpx;
  text-align: left;
}
.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 24rpx; }

.sub-nav {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.sub-tab {
  flex: 1;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  min-height: 0;
}
.sub-tab.sub-active {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 600;
}

.stats {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
  align-items: stretch;
}
.stat-item {
  flex: 1;
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
}
.stat-num { font-size: 36rpx; font-weight: 700; color: var(--primary); }
.stat-label { font-size: 20rpx; color: var(--text-hint); margin-top: 4rpx; }
.record-entry {
  flex: 2;
  background: var(--bg-warm);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-lg);
  font-size: 24rpx;
  color: var(--text-secondary);
  min-height: 0;
}

.stage-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}
.stage-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
}
.stage-icon { font-size: 40rpx; }
.stage-info { flex: 1; }
.stage-name { font-size: 28rpx; font-weight: 700; }
.stage-desc { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; }
.stage-meta { display: flex; align-items: center; gap: 12rpx; }
.stage-progress { font-size: 24rpx; color: var(--primary); font-weight: 600; }
.stage-arrow { font-size: 22rpx; color: var(--text-hint); }

.task-list { padding: 0 32rpx 28rpx; }
.task-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--border);
}
.task-item.task-done .task-title {
  color: var(--text-hint);
  text-decoration: line-through;
}
.task-check {
  font-size: 40rpx;
  min-height: 0;
  padding: 0;
  line-height: 1;
}
.task-content { flex: 1; }
.task-title { font-size: 26rpx; font-weight: 600; }
.task-desc { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; line-height: 1.6; }
.task-meta { font-size: 20rpx; color: var(--text-hint); margin-top: 8rpx; }
.task-tip {
  font-size: 20rpx;
  color: var(--accent);
  background: rgba(232,152,94,0.1);
  border-radius: var(--radius-sm);
  padding: 12rpx 16rpx;
  margin-top: 12rpx;
  line-height: 1.5;
}
.task-feeling {
  font-size: 22rpx;
  color: var(--success);
  font-style: italic;
  margin-top: 8rpx;
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.type-btn {
  width: calc(33.33% - 12rpx);
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 20rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  min-height: 0;
}
.type-btn.type-selected {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 600;
}
.note-input {
  width: 100%;
  background: var(--surface);
  border-radius: var(--radius-md);
  border: 2rpx solid var(--border);
  padding: 24rpx;
  font-size: 26rpx;
  margin-bottom: 32rpx;
}
.submit-btn {
  width: 100%;
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 26rpx;
  font-size: 30rpx;
  font-weight: 600;
  min-height: 88rpx;
}
.submit-btn.inline { width: auto; flex: 1; }

.feeling-view {
  text-align: center;
  padding-top: 64rpx;
}
.feeling-hint { font-size: 24rpx; color: var(--text-hint); margin: 16rpx 0 32rpx; text-align: left; }
.feeling-btns { display: flex; gap: 24rpx; margin-top: 16rpx; }
.skip-btn {
  flex: 1;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  min-height: 84rpx;
}

.story-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.filter-btn {
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: 40rpx;
  padding: 14rpx 32rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  min-height: 0;
}
.filter-btn.filter-active {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}
.story-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.story-card-title { font-size: 30rpx; font-weight: 700; }
.story-card-summary { font-size: 24rpx; color: var(--text-secondary); margin-top: 8rpx; }
.story-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.story-tag {
  font-size: 20rpx;
  color: var(--primary);
  background: rgba(74,144,217,0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.story-title { font-size: 36rpx; font-weight: 700; margin-bottom: 16rpx; }
.story-body { font-size: 26rpx; color: var(--text-secondary); line-height: 1.9; margin-top: 24rpx; }
.para { min-height: 44rpx; }
.story-footer {
  font-size: 22rpx;
  color: var(--text-hint);
  text-align: right;
  margin-top: 32rpx;
}

.disclaimer {
  font-size: 22rpx;
  color: var(--text-hint);
  text-align: center;
  padding: 32rpx 0 0;
  line-height: 1.6;
}
