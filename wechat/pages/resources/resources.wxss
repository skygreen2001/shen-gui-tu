.content {
  padding: 0 32rpx calc(var(--nav-height) + 64rpx);
}
.tabs-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 32rpx;
}
.tabs {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}
.tab {
  display: inline-block;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
}
.tab.active-tab {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 600;
}

.filter { margin-bottom: 24rpx; }
.select {
  display: inline-block;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  border: 2rpx solid var(--border);
}

.card { margin-bottom: 24rpx; }
.card-name { font-size: 30rpx; font-weight: 700; }
.card-info { font-size: 24rpx; color: var(--text-secondary); margin-top: 8rpx; }
.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.tag {
  font-size: 20rpx;
  color: var(--primary);
  background: rgba(74,144,217,0.12);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.tag-success {
  color: var(--success);
  background: rgba(107,175,122,0.12);
}
.card-link {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
  margin-top: 16rpx;
}

.hotline-card { padding: 32rpx; }
.hotline-card.featured {
  border-left: 8rpx solid var(--danger);
}
.hotline-name { font-size: 28rpx; font-weight: 700; }
.hotline-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
  margin: 12rpx 0;
}
.hotline-time { font-size: 22rpx; color: var(--text-hint); }

.policy-item { padding: 32rpx; }
.policy-title { font-size: 30rpx; font-weight: 700; }
.policy-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
  line-height: 1.6;
}
.highlight { color: var(--accent); font-weight: 700; font-size: 32rpx; }
.policy-detail {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

/* ====== 微信公众号Tab ====== */
.wechat-card {
  padding: 32rpx;
  border: 2rpx solid #E8F5E9;
  background: #FFFFFF;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}
.wechat-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.wechat-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: block;
  flex-shrink: 0;
}
.wechat-info { flex: 1; min-width: 0; }
.wechat-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  word-break: break-all;
}
.wechat-sub {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}
.wechat-tag-row {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 20rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}
.wechat-tag-label {
  color: #2E7D32;
  font-weight: 600;
}
.wechat-tag-sep {
  color: #CCC;
}
.wechat-tag-text {
  color: #666;
}
.wechat-desc {
  background: #F1F8E9;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.wechat-desc-text {
  display: block;
  font-size: 26rpx;
  color: #4A4A4A;
  line-height: 1.7;
}
.wechat-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FAFAFA;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.wechat-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.wechat-stat-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #2E7D32;
}
.wechat-stat-label {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}
.wechat-stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: #E0E0E0;
}
.wechat-tip {
  background: #FFF8E1;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}
.wechat-tip-text {
  font-size: 24rpx;
  color: #666;
}
