.ft-container {
  padding: 0 0 32rpx;
}
.back-btn {
  font-size: 28rpx;
  color: var(--primary);
  min-height: 0;
  padding: 8rpx 0;
  margin-bottom: 16rpx;
  text-align: left;
}
.course-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.step-dots {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--border);
}
.dot.active-dot { background: var(--primary); transform: scale(1.2); }
.dot.done-dot { background: var(--success); }

.step-card { margin-bottom: 24rpx; }
.step-type {
  display: inline-block;
  font-size: 20rpx;
  color: var(--primary);
  background: rgba(74,144,217,0.12);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}
.step-title { font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; }
.step-body { font-size: 26rpx; color: var(--text-secondary); line-height: 1.8; }
.line { min-height: 40rpx; }

.step-nav {
  display: flex;
  gap: 24rpx;
  margin-bottom: 48rpx;
}
.nav-btn {
  flex: 1;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  min-height: 84rpx;
}
.nav-btn.primary {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 600;
}
.nav-btn[disabled] { opacity: 0.5; }

.section { margin-bottom: 48rpx; }
.section-title { font-size: 30rpx; font-weight: 700; }
.section-desc {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.course-grid { display: flex; flex-direction: column; gap: 20rpx; }
.course-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: var(--shadow-sm);
}
.course-card.course-done { border: 2rpx solid var(--success); }
.course-icon { font-size: 44rpx; }
.course-info { flex: 1; }
.course-name { font-size: 28rpx; font-weight: 700; }
.course-desc { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; }
.done-badge {
  color: #fff;
  background: var(--success);
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.guide-card {
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  overflow: hidden;
}
.guide-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx;
}
.guide-icon { font-size: 36rpx; }
.guide-label { flex: 1; font-size: 28rpx; font-weight: 700; }
.guide-arrow { color: var(--text-hint); font-size: 24rpx; }
.guide-body { padding: 0 32rpx 28rpx; }
.guide-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 16rpx;
}
.guide-sub-title {
  font-size: 26rpx;
  font-weight: 700;
  margin: 16rpx 0 8rpx;
}
.guide-item {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}
.guide-reminder {
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  margin-top: 20rpx;
  line-height: 1.6;
}

.assess-entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.assess-btn {
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 20rpx 48rpx;
  font-size: 26rpx;
  font-weight: 600;
  min-height: 0;
}
.assess-last { font-size: 22rpx; color: var(--text-hint); flex: 1; }

.assess-hint {
  font-size: 22rpx;
  color: var(--text-hint);
  margin: 16rpx 0 32rpx;
}
.question-item { margin-bottom: 32rpx; }
.question-text { font-size: 26rpx; margin-bottom: 16rpx; line-height: 1.5; }
.rating-row { display: flex; gap: 16rpx; }
.rating-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-secondary);
  min-height: 72rpx;
}
.rating-btn.rating-selected {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 700;
}

.submit-btn {
  width: 100%;
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 26rpx;
  font-size: 30rpx;
  font-weight: 600;
  min-height: 88rpx;
  margin-top: 16rpx;
}

.result-card {
  border: 4rpx solid;
  border-radius: var(--radius-lg);
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 32rpx;
}
.result-score { font-size: 56rpx; font-weight: 700; }
.result-label { font-size: 30rpx; font-weight: 700; margin: 12rpx 0; }
.result-advice { font-size: 24rpx; color: var(--text-secondary); line-height: 1.7; }

.self-care-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.self-care-list { margin-top: 24rpx; }
.self-care-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.self-care-input {
  flex: 1;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  border: 2rpx solid var(--border);
}
.remove-btn {
  color: var(--danger);
  font-size: 28rpx;
  min-height: 0;
  padding: 8rpx;
}
.add-btn {
  width: 100%;
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-md);
  color: var(--primary);
  font-size: 26rpx;
  padding: 20rpx;
  min-height: 0;
}

.disclaimer {
  font-size: 22rpx;
  color: var(--text-hint);
  text-align: center;
  padding: 32rpx 0 0;
  line-height: 1.6;
}
.card { box-shadow: var(--shadow-sm); }
