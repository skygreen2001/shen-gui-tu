.page { min-height: 100vh; }
.content {
  padding: 16rpx 32rpx calc(var(--nav-height) + var(--crisis-size) + 64rpx);
}
.checkin-btn {
  width: 100%;
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-md);
  min-height: 92rpx;
  margin: 16rpx 0 32rpx;
}
.checkin-btn.checked {
  background: var(--success);
}
.checkin-btn:active { transform: scale(0.98); }

.stats {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}
.stat-card {
  flex: 1;
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
}
.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

.trend { margin-bottom: 32rpx; }
.trend-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.trend-chart {
  display: flex;
  justify-content: space-between;
  height: 280rpx;
  align-items: flex-end;
}
.trend-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 240rpx;
}
.trend-bar {
  width: 10rpx;
  border-radius: 5rpx 5rpx 0 0;
}
.trend-day-label {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
}

.risk-banner {
  background: #FFEBEE;
  border: 1rpx solid rgba(212,107,107,0.3);
  border-radius: var(--radius-md);
  padding: 24rpx;
  display: flex;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--danger);
  margin-bottom: 32rpx;
  line-height: 1.5;
}
.hotline {
  color: var(--danger);
  font-weight: 700;
  text-decoration: underline;
}

.wrap-entry {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 32rpx;
}
.wrap-entry-icon { font-size: 48rpx; }
.wrap-entry-text { flex: 1; }
.wrap-entry-title { font-size: 28rpx; font-weight: 700; }
.wrap-entry-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 1.5;
}
.wrap-entry-arrow { color: var(--text-hint); font-size: 32rpx; }

.reset-btn {
  width: 100%;
  border: 1rpx dashed var(--border);
  border-radius: var(--radius-md);
  color: var(--text-hint);
  font-size: 24rpx;
  padding: 20rpx;
  min-height: 0;
}
