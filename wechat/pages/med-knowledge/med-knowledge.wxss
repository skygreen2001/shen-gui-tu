.container {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
}
.header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}
.back-btn {
  font-size: 28rpx;
  color: var(--primary);
  min-height: 0;
  padding: 8rpx 16rpx;
}
.title {
  font-size: 38rpx;
  font-weight: 700;
  flex: 1;
}

.panel {
  background: var(--surface);
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}
.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.panel.open .panel-header { color: var(--primary); }
.arrow { font-size: 22rpx; color: var(--text-hint); transition: transform 0.2s; }
.panel.open .arrow { transform: rotate(180deg); }
.panel-body {
  padding: 0 32rpx 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}
.list-item { margin-bottom: 8rpx; }

.disclaimer {
  font-size: 22rpx;
  color: var(--text-hint);
  text-align: center;
  padding: 32rpx;
  line-height: 1.6;
}

.empty {
  text-align: center;
  padding-top: 160rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; font-weight: 700; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: var(--text-secondary); }
