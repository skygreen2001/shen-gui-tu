.page {
  min-height: 100vh;
  padding-bottom: 64rpx;
}
.hero {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--bg) 100%);
  padding: 96rpx 32rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  top: -120rpx; right: -120rpx;
  width: 400rpx; height: 400rpx;
  background: radial-gradient(circle, rgba(74,144,217,0.15), transparent 70%);
  border-radius: 50%;
}
.hero::after {
  content: '';
  position: absolute;
  bottom: -80rpx; left: -80rpx;
  width: 320rpx; height: 320rpx;
  background: radial-gradient(circle, rgba(232,152,94,0.12), transparent 70%);
  border-radius: 50%;
}
.brand {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 16rpx;
  position: relative;
  z-index: 1;
}
.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
  position: relative;
  z-index: 1;
}
.props {
  display: flex;
  padding: 48rpx 32rpx;
}
.prop {
  flex: 1;
  text-align: center;
  padding: 32rpx 16rpx;
}
.prop-icon { font-size: 56rpx; margin-bottom: 16rpx; }
.prop-title { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.prop-desc { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; }
.delay-1 { animation-delay: 0.1s; }
.delay-2 { animation-delay: 0.15s; }

.divider {
  text-align: center;
  padding: 32rpx;
  position: relative;
}
.divider::before {
  content: '';
  position: absolute;
  top: 50%; left: 32rpx; right: 32rpx;
  height: 1px;
  background: var(--border);
}
.divider text {
  background: var(--bg);
  padding: 0 32rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  position: relative;
}

.stats {
  display: flex;
  padding: 0 32rpx 48rpx;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}
.stat-label { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; }

.cta {
  padding: 0 32rpx 64rpx;
  text-align: center;
}
.cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 96rpx;
  background: var(--accent);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(232,152,94,0.3);
  min-height: 96rpx;
}
.cta-btn:active { transform: scale(0.96); }

.disclaimer {
  padding: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-hint);
  border-top: 1rpx solid var(--border);
  line-height: 1.8;
}
.hotline { color: var(--primary); font-weight: 600; }
