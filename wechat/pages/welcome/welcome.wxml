<view class="page">
  <view class="hero fade-in">
    <view class="brand">申归途</view>
    <view class="subtitle">抑郁症复发预防支持工具</view>
  </view>

  <view class="props">
    <view class="prop fade-in">
      <view class="prop-icon">📋</view>
      <view class="prop-title">每日追踪</view>
      <view class="prop-desc">6维度签到</view>
    </view>
    <view class="prop fade-in delay-1">
      <view class="prop-icon">💊</view>
      <view class="prop-title">用药提醒</view>
      <view class="prop-desc">智能管理</view>
    </view>
    <view class="prop fade-in delay-2">
      <view class="prop-icon">🛡️</view>
      <view class="prop-title">危机守护</view>
      <view class="prop-desc">一键求助</view>
    </view>
  </view>

  <view class="divider"><text>数据支撑</text></view>

  <view class="stats">
    <view class="stat">
      <view class="stat-num">50%</view>
      <view class="stat-label">复发率</view>
    </view>
    <view class="stat">
      <view class="stat-num">2年</view>
      <view class="stat-label">高发期</view>
    </view>
    <view class="stat">
      <view class="stat-num">85%</view>
      <view class="stat-label">可预防</view>
    </view>
  </view>

  <view class="cta">
    <button class="cta-btn" bindtap="start">开始使用</button>
  </view>

  <view class="disclaimer">
    <view>本工具仅作为辅助支持，不替代专业医疗建议</view>
    <view>如需帮助请拨打 <text class="hotline" bindtap="callHotline">心理热线 962525</text></view>
  </view>
</view>
