.page {
  min-height: 100vh;
  padding-bottom: 64rpx;
}
.hero {
  background: linear-gradient(135deg, rgba(212,107,107,0.15) 0%, var(--bg) 100%);
  padding: 64rpx 32rpx;
  text-align: center;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}
.hero-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.actions {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.primary-btn {
  width: 100%;
  background: var(--danger);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 700;
  min-height: 96rpx;
  box-shadow: 0 8rpx 24rpx rgba(212,107,107,0.3);
}
.secondary-btn {
  width: 100%;
  background: var(--surface);
  color: var(--danger);
  border: 2rpx solid var(--danger);
  border-radius: var(--radius-md);
  padding: 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  min-height: 96rpx;
}

.channels {
  margin: 0 32rpx 32rpx;
  padding: 16rpx 32rpx;
}
.channel-item {
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--primary);
  border-bottom: 1rpx solid var(--border);
}
.channel-item:last-child { border-bottom: none; }

.breath-section { padding: 0 32rpx 32rpx; }
.breath-card {
  text-align: center;
  padding: 48rpx 32rpx;
}
.breath-title { font-size: 32rpx; font-weight: 700; margin-bottom: 40rpx; }
.circle-wrap {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  margin: 0 auto 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.circle {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--primary-light);
  transition: transform 4s ease, background 1s;
}
.circle.inhale { transform: scale(2); background: var(--primary); }
.circle.hold { transform: scale(2); background: var(--warning); }
.circle.exhale { transform: scale(1); background: var(--primary-light); transition-duration: 8s; }
.breath-text {
  position: relative;
  z-index: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.breath-btn {
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  width: 100%;
  min-height: 88rpx;
}

.safety-card {
  margin: 0 32rpx;
  padding: 32rpx;
}
.safety-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }
.safety-item {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 12rpx 0;
  line-height: 1.6;
}
.safety-item::before { content: '• '; color: var(--danger); }
