.content {
  padding: 16rpx 32rpx 96rpx;
}
.dim-group {
  margin-bottom: 40rpx;
  animation: fadeIn 0.4s ease both;
}
.dim-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.radio-group {
  display: flex;
  gap: 20rpx;
}
.radio-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  color: var(--text-secondary);
  transition: all 0.15s;
}
.radio-btn.selected {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 700;
  transform: scale(1.05);
}
.rating-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--text-hint);
}

.note-wrap { margin-bottom: 40rpx; }
.note {
  width: 100%;
  min-height: 160rpx;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 26rpx;
}

.submit-btn {
  width: 100%;
  background: var(--border);
  color: var(--text-hint);
  border-radius: var(--radius-md);
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  min-height: 92rpx;
}
.submit-btn.ready {
  background: var(--primary);
  color: #fff;
  animation: pulseBtn 2s infinite;
}
.submit-btn[disabled] {
  color: var(--text-hint);
  background: var(--border);
}

.done-card {
  text-align: center;
  padding: 64rpx 32rpx;
}
.done-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.done-title { font-size: 36rpx; font-weight: 700; margin-bottom: 16rpx; }
.done-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
  line-height: 1.6;
}
.re-edit-btn {
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  min-height: 84rpx;
}
