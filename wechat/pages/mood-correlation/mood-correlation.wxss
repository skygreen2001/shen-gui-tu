.container {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
}
.header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}
.back-btn {
  font-size: 28rpx;
  color: var(--primary);
  min-height: 0;
  padding: 8rpx 16rpx;
}
.title { font-size: 38rpx; font-weight: 700; flex: 1; }

.empty {
  text-align: center;
  padding: 96rpx 32rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; font-weight: 700; margin-bottom: 12rpx; }
.empty-hint { font-size: 24rpx; color: var(--text-hint); }

.chart-section { margin-bottom: 32rpx; }
.chart-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }
.chart-legend {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}
.legend-item { display: flex; align-items: center; gap: 8rpx; }
.legend-dot { width: 20rpx; height: 20rpx; border-radius: 6rpx; }
.mood-dot { background: var(--primary); }
.se-dot { background: var(--danger); }

.chart {
  display: flex;
  justify-content: space-around;
  height: 320rpx;
  align-items: flex-end;
}
.bar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 72rpx;
}
.bar-row {
  height: 120rpx;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar {
  width: 28rpx;
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.4s;
}
.mood-bar { background: var(--primary); }
.se-bar { background: var(--danger); }
.bar-label {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
}

.insight-card {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 24rpx 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  line-height: 1.6;
  box-shadow: var(--shadow-sm);
}

.disclaimer {
  font-size: 22rpx;
  color: var(--text-hint);
  text-align: center;
  padding: 32rpx 0 0;
  line-height: 1.6;
}
