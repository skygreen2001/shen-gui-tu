.container {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
}
.header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}
.back-btn {
  font-size: 28rpx;
  color: var(--primary);
  min-height: 0;
  padding: 8rpx 16rpx;
}
.title { font-size: 38rpx; font-weight: 700; flex: 1; }

.warning {
  background: #FFF3E0;
  border: 1rpx solid rgba(232,152,94,0.4);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 24rpx;
  color: #E65100;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.card { margin-bottom: 32rpx; }

.form-title { font-size: 30rpx; font-weight: 700; margin-bottom: 24rpx; }
.input {
  width: 100%;
  height: 84rpx;
  background: var(--bg);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.phase-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}
.phase-label { font-size: 26rpx; color: var(--text-secondary); margin-right: 16rpx; }
.select {
  background: var(--bg);
  border-radius: var(--radius-md);
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}
.submit-btn {
  width: 100%;
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 26rpx;
  font-size: 30rpx;
  font-weight: 600;
  min-height: 88rpx;
}

.plan-info { text-align: center; }
.plan-med { font-size: 34rpx; font-weight: 700; }
.plan-dose { font-size: 26rpx; color: var(--text-secondary); margin-top: 8rpx; }

.timeline { margin: 16rpx 8rpx 32rpx; }
.phase {
  position: relative;
  padding-left: 56rpx;
  padding-bottom: 48rpx;
}
.phase:last-child { padding-bottom: 0; }
.phase-dot {
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--border);
  z-index: 1;
}
.phase.current .phase-dot { background: var(--primary); }
.phase.done .phase-dot { background: var(--success); }
.phase-line {
  position: absolute;
  left: 22rpx;
  top: 32rpx;
  bottom: 0;
  width: 4rpx;
  background: var(--border);
}
.phase.done .phase-line { background: var(--success); }
.phase-content {}
.phase-label { font-size: 28rpx; font-weight: 600; }
.phase.current .phase-label { color: var(--primary); }
.phase-duration { font-size: 22rpx; color: var(--text-hint); margin: 4rpx 0 12rpx; }
.done-btn {
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  min-height: 0;
}
.done-label { font-size: 24rpx; color: var(--success); }

.report-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 24rpx;
}

.empty { text-align: center; padding: 64rpx 32rpx; }
.empty-text { font-size: 26rpx; color: var(--text-hint); margin-bottom: 32rpx; }
