/* 申归途 · 微信小程序全局样式（与 H5 主题一致） */
page {
  --primary: #4A90D9;
  --primary-light: #A8CCE8;
  --primary-dark: #2C6FB5;
  --accent: #E8985E;
  --accent-light: #F5C9A0;
  --bg: #F8F6F2;
  --bg-warm: #FDF8F0;
  --surface: #FFFFFF;
  --text-primary: #2D3436;
  --text-secondary: #636E72;
  --text-hint: #B2BEC3;
  --border: #E8E4DE;
  --success: #6BAF7A;
  --warning: #E8C95A;
  --danger: #D46B6B;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
  --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
  --shadow-lg: 0 8px 24px rgba(0,0,0,0.12);
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 32rpx;
  --space-lg: 48rpx;
  --space-xl: 64rpx;
  --space-2xl: 96rpx;
  --nav-height: 128rpx;
  --crisis-size: 112rpx;

  background: var(--bg);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

view, text, button, input, textarea, image {
  box-sizing: border-box;
}

button {
  font-family: inherit;
  background: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
  border: none;
}
button::after { border: none; }

/* 通用页头 */
.page-header {
  padding: 32rpx 32rpx 16rpx;
}
.page-header h1,
.page-header .h1 {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.page-header .sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 通用卡片 */
.card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

/* 危机求助悬浮按钮（对应 H5 CrisisButton） */
.crisis-btn {
  position: fixed;
  bottom: calc(var(--nav-height) + 32rpx);
  left: 50%;
  transform: translateX(-50%);
  width: var(--crisis-size);
  height: var(--crisis-size);
  border-radius: 50%;
  background: var(--danger);
  border: none;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(212,107,107,0.4);
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { box-shadow: 0 8rpx 32rpx rgba(212,107,107,0.4); }
  50% { box-shadow: 0 8rpx 48rpx rgba(212,107,107,0.6); }
}

/* 底部留出 tabbar 空间（非 tab 页） */
.page-pad {
  padding-bottom: calc(var(--nav-height) + var(--crisis-size) + 64rpx);
}
.tab-page-pad {
  padding-bottom: calc(var(--nav-height) + 64rpx);
}

.fade-in {
  animation: fadeIn 0.4s ease both;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulseBtn {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}
